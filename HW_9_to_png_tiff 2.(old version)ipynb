      "source": [
        "# Install necessary libraries (Run this in Colab by putting an '!' before pip)\n",
        "# !pip install satpy[all] pyresample dask rasterio bz2file requests pyspectral pyorbital h5py\n",
        "#only for true color reproduction png\n",
        "import os\n",
        "import re\n",
        "import bz2\n",
        "import requests\n",
        "import warnings\n",
        "import concurrent.futures\n",
        "import dask\n",
        "from satpy import Scene\n",
        "from dask.diagnostics import ProgressBar\n",
        "\n",
        "# ==========================================================\n",
        "# STRICT RAM LIMITERS\n",
        "# ==========================================================\n",
        "dask.config.set({\"array.chunk-size\": \"32MiB\"})\n",
        "dask.config.set(num_workers=2)\n",
        "warnings.filterwarnings('ignore')\n",
        "\n",
        "# ==========================================================\n",
        "# 1. USER INPUT: Paste any Himawari-9 S3 link here\n",
        "# ==========================================================\n",
        "# @markdown ### Paste your Himawari-9 S3 link here:\n",
        "user_url = \"https://noaa-himawari9.s3.amazonaws.com/AHI-L1b-Target/2026/04/12/0640/HS_H09_20260412_0640_B01_R301_R10_S0101.DAT.bz2\" # @param {type:\"string\"}\n",
        "\n",
        "# ==========================================================\n",
        "# 2. SMART URL PARSING (Universal for FLDK, Target, and Japan areas)\n",
        "# ==========================================================\n",
        "# This regex dynamically extracts the timestamp, the area code (FLDK, R301, etc.),\n",
        "# and the total number of segments from the provided URL.\n",
        "regex_pattern = r'^(.*?/)HS_H09_(\\d{8}_\\d{4})_B\\d{2}_([A-Z0-9]+)_R\\d{2}_S\\d{2}(\\d{2})\\.DAT\\.bz2$'\n",
        "match = re.search(regex_pattern, user_url)\n",
        "\n",
        "if not match:\n",
        "    raise ValueError(\"Could not parse the URL. Please ensure it is a valid Himawari Amazon S3 link.\")\n",
        "\n",
        "base_url = match.group(1)\n",
        "timestamp = match.group(2)\n",
        "obs_area = match.group(3)           # e.g., 'FLDK', 'R301', 'JP01'\n",
        "total_segments = int(match.group(4)) # e.g., 10 for FLDK, 1 for Target\n",
        "\n",
        "total_files = 4 * total_segments\n",
        "print(f\"Detected Timestamp: {timestamp}\")\n",
        "print(f\"Observation Area: {obs_area}\")\n",
        "print(f\"Total Segments: {total_segments}\")\n",
        "print(f\"Downloading and decompressing {total_files} files...\")\n",
        "\n",
        "# ==========================================================\n",
        "# 3. DOWNLOADING FILES\n",
        "# ==========================================================\n",
        "bands_resolutions = {\"B01\": \"R10\", \"B02\": \"R10\", \"B03\": \"R05\", \"B04\": \"R10\"}\n",
        "download_tasks = []\n",
        "\n",
        "# Dynamically generate links based on the detected area and segment count\n",
        "for band, res in bands_resolutions.items():\n",
        "    for seg in range(1, total_segments + 1):\n",
        "        segment_str = f\"S{seg:02d}{total_segments:02d}\" # Formats correctly (e.g., S0101 or S0110)\n",
        "        filename = f\"HS_H09_{timestamp}_{band}_{obs_area}_{res}_{segment_str}.DAT\"\n",
        "        bz2_filename = filename + \".bz2\"\n",
        "        download_tasks.append((base_url + bz2_filename, filename, bz2_filename))\n",
        "\n",
        "downloaded_files = []\n",
        "\n",
        "def download_and_decompress(task):\n",
        "    url, filename, bz2_filename = task\n",
        "    if not os.path.exists(filename):\n",
        "        response = requests.get(url, stream=True)\n",
        "        if response.status_code == 200:\n",
        "            with open(filename, 'wb') as f_out:\n",
        "                f_out.write(bz2.decompress(response.content))\n",
        "            return filename\n",
        "        else:\n",
        "            print(f\"Failed to download: {url}\")\n",
        "            return None\n",
        "    return filename\n",
        "\n",
        "with concurrent.futures.ThreadPoolExecutor(max_workers=8) as executor:\n",
        "    results = executor.map(download_and_decompress, download_tasks)\n",
        "    for result in results:\n",
        "        if result: downloaded_files.append(result)\n",
        "\n",
        "if not downloaded_files:\n",
        "    raise RuntimeError(\"No files were successfully downloaded. Check the link and internet connection.\")\n",
        "\n",
        "# ==========================================================\n",
        "# 4. PROCESSING THE IMAGE\n",
        "# ==========================================================\n",
        "print(\"\\nLoading data into Satpy...\")\n",
