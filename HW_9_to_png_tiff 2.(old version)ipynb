        "#only works for target/japan\n",
        "import os\n",
        "import re\n",
        "import bz2\n",
        "import requests\n",
        "import warnings\n",
        "import concurrent.futures\n",
        "import dask\n",
        "import imageio\n",
        "import numpy as np\n",
        "import gc\n",
        "from datetime import datetime, timedelta\n",
        "from satpy import Scene\n",
        "from dask.diagnostics import ProgressBar\n",
        "\n",
        "# ==========================================================\n",
        "# CONFIGURATION & UI\n",
        "# ==========================================================\n",
        "# @markdown ### 🛰️ Himawari target only\n",
        "user_url = \"https://noaa-himawari9.s3.amazonaws.com/AHI-L1b-FLDK/2025/08/01/0640/HS_H09_20250801_0640_B03_FLDK_R05_S0110.DAT.bz2\" # @param {type:\"string\"}\n",
        "mode = \"Timelapse\" # @param [\"Single Image\", \"Timelapse\"]\n",
        "# @markdown ---\n",
        "# @markdown ### 🎬 Options\n",
        "hours_back = 12 # @param {type:\"slider\", min:1, max:72, step:1}\n",
        "interval_minutes = 60 # @param {type:\"slider\", min:2, max:120, step:2}\n",
        "fps = 10 # @param {type:\"slider\", min:1, max:30, step:1}\n",
        "# @markdown **Enable IR Fallback** to see clouds during nighttime frames:\n",
        "use_ir_at_night = False # @param {type:\"boolean\"}\n",
        "# @markdown **True Color Reproduction** (Enhances color for natural look):\n",
        "true_color_repro = True # @param {type:\"boolean\"}\n",
        "\n",
        "# ==========================================================\n",
        "# EXTREME RAM OPTIMIZATION (Optimized for <7GB RAM)\n",
        "# ==========================================================\n",
        "dask.config.set({\"array.chunk-size\": \"16MiB\"})\n",
        "dask.config.set(num_workers=1) # Reduce parallel processing to save RAM\n",
        "warnings.filterwarnings('ignore')\n",
        "\n",
        "def parse_url_robust(url):\n",
        "    pattern = r'(https?://.*?/AHI-L1b-(?:Target|FLDK|Japan)/)(\\d{4}/\\d{2}/\\d{2}/\\d{4}/)HS_H09_(\\d{8}_\\d{4})_B\\d{2}_([A-Z0-9]+)_R\\d{2}_S\\d{2}(\\d{2})'\n",
        "    m = re.search(pattern, url)\n",
        "    if not m: return None\n",
        "    return {\n",
        "        \"root\": m.group(1),\n",
        "        \"timestamp\": m.group(3),\n",
        "        \"area\": m.group(4),\n",
        "        \"total_segs\": int(m.group(5))\n",
        "    }\n",
        "\n",
        "def download_and_extract(url, fn):\n",
        "    if os.path.exists(fn): return fn\n",
        "    try:\n",
        "        r = requests.get(url, timeout=15)\n",
        "        if r.status_code == 200:\n",
        "            with open(fn, 'wb') as f:\n",
        "                f.write(bz2.decompress(r.content))\n",
        "            return fn\n",
        "    except: pass\n",
        "    return None\n",
        "\n",
        "info = parse_url_robust(user_url)\n",
        "if not info: raise ValueError(\"URL Format not recognized.\")\n",
        "\n",
        "start_dt = datetime.strptime(info['timestamp'], \"%Y%m%d_%H%M\")\n",
        "steps = [start_dt] if mode == \"Single Image\" else [start_dt - timedelta(minutes=i*interval_minutes) for i in range(int(hours_back*60/interval_minutes))]\n",
        "if mode != \"Single Image\": steps.reverse()\n",
        "\n",
        "frames = []\n",
        "master_area = None\n",
        "\n",
        "print(f\"Mode: {mode}. Memory Optimization Active.\")\n",
        "\n",
        "for idx, dt in enumerate(steps):\n",
        "    t_str, d_path = dt.strftime(\"%Y%m%d_%H%M\"), dt.strftime(\"%Y/%m/%d/%H%M/\")\n",
        "    current_batch, download_tasks = [], []\n",
        "    bands_to_get = [\"B01\", \"B02\", \"B03\", \"B04\"]\n",
        "    if use_ir_at_night or mode == \"Single Image\": bands_to_get.append(\"B13\")\n",
        "\n",
        "    for b in bands_to_get:\n",
        "        res = \"R05\" if b == \"B03\" else \"R20\" if b == \"B13\" else \"R10\"\n",
        "        for s in range(1, info['total_segs'] + 1):\n",
        "            fn = f\"HS_H09_{t_str}_{b}_{info['area']}_{res}_S{s:02d}{info['total_segs']:02d}.DAT\"\n",
        "            download_tasks.append((f\"{info['root']}{d_path}{fn}.bz2\", fn))\n",
        "\n",
        "    print(f\"[{idx+1}/{len(steps)}] {t_str} -> Downloading segments... \", end=\"\")\n",
        "    with concurrent.futures.ThreadPoolExecutor(max_workers=6) as executor:\n",
        "        results = list(executor.map(lambda p: download_and_extract(*p), download_tasks))\n",
        "        current_batch = [r for r in results if r]\n",
        "\n",
        "    try:\n",
        "        scn = Scene(filenames=current_batch, reader='ahi_hsd')\n",
        "        if 'B13' in bands_to_get: scn.load(['B13'], calibration='brightness_temperature')\n",
        "\n",
        "        comp_id = 'true_color'\n",
        "        scn.load([comp_id])\n",
        "\n",
        "        is_night = comp_id not in scn or np.nanmax(scn[comp_id].values) < 0.02\n",
        "        composite = 'B13' if (is_night and use_ir_at_night) else comp_id\n",
        "\n",
        "        if master_area is None:\n",
        "             master_area = scn['B13'].attrs['area'] if 'B13' in scn else scn.coarsest_area()\n",
        "\n",
        "        # Use native resampler for maximum memory savings\n",
        "        local_scn = scn.resample(master_area, resampler='native')\n",
        "\n",
        "        if mode == \"Single Image\":\n",
        "            geotiff_filename = f\"Himawari9_{info['area']}_{t_str}.tif\"\n",
        "            png_filename = f\"Himawari9_{info['area']}_{t_str}.png\"\n",
        "            print(\"Saving Tiled Exports... \", end=\"\")\n",
        "            with ProgressBar():\n",
        "                local_scn.save_dataset(composite, filename=geotiff_filename, writer='geotiff',\n",
        "                                       tiled=True, blockxsize=1024, blockysize=1024)\n",
        "                local_scn.save_dataset(composite, filename=png_filename, writer='simple_image',\n",
        "                                       enhance=true_color_repro or composite=='B13')\n",
        "        else:\n",
        "            tmp_png = f\"frame_{idx:03d}.png\"\n",
        "            local_scn.save_dataset(composite, filename=tmp_png, writer='simple_image',\n",
        "                                   enhance=true_color_repro or composite=='B13')\n",
        "            frames.append(tmp_png)\n",
        "\n",
        "        print(\"Done.\")\n",
        "\n",
        "    except Exception as e:\n",
        "        print(f\"Error: {e}\")\n",
        "    finally:\n",
        "        if 'scn' in locals(): del scn\n",
        "        if 'local_scn' in locals(): del local_scn\n",
        "        gc.collect() # Immediate garbage collection\n",
        "        for f in current_batch:\n",
        "            if os.path.exists(f): os.remove(f)\n",
        "\n",
        "if mode == \"Timelapse\" and frames:\n",
        "    gif_name = f\"Himawari_Hybrid_{info['timestamp']}.gif\"\n",
        "    with imageio.get_writer(gif_name, mode='I', duration=1000/fps, loop=0) as writer:\n",
        "        for f in frames:\n",
        "            writer.append_data(imageio.imread(f))\n",
        "            os.remove(f)\n",
        "    print(f\"✅ GIF Created: {gif_name}\")\n",
        "\n",
        "print(\"\\nProcess Complete.\")"
      ]
    },
