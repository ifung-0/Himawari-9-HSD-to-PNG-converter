        "\n",
        "# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n",
        "#  🔧 HELPERS\n",
        "# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n",
        "\n",
        "def parse_url(url):\n",
        "    pattern = (r'(https?://.*?/AHI-L1b-(?:Target|FLDK|Japan)/)(\\d{4}/\\d{2}/\\d{2}/\\d{4}/)'\n",
        "               r'(HS_H0[89])_(\\d{8}_\\d{4})_B\\d{2}_([A-Z0-9]+)_R\\d{2}_S\\d{2}(\\d{2})')\n",
        "    m = re.search(pattern, url)\n",
        "    if not m: raise ValueError(\"❌ URL not recognised.\")\n",
        "    return {\"root\": m.group(1), \"sat_id\": m.group(3), \"timestamp\": m.group(4), \"area\": m.group(5), \"total_segs\": int(m.group(6))}\n",
        "\n",
        "def download_and_extract(url, filename):\n",
        "    if os.path.exists(filename): return filename\n",
        "    try:\n",
        "        r = requests.get(url, timeout=30)\n",
        "        if r.status_code == 200:\n",
        "            with open(filename, \"wb\") as f: f.write(bz2.decompress(r.content))\n",
        "            return filename\n",
        "    except Exception: pass\n",
        "    return None\n",
        "\n",
        "def apply_ir_colormap(data, cmap_name=\"inferno\"):\n",
        "    valid_mask = ~np.isnan(data)\n",
        "    if not np.any(valid_mask): return np.zeros((data.shape[0], data.shape[1], 3), dtype=np.uint8)\n",
        "    vmin, vmax = np.percentile(data[valid_mask], [2, 98])\n",
        "    if vmax - vmin < 1e-5: vmax = vmin + 1.0\n",
        "    data_norm = np.clip((data - vmin) / (vmax - vmin), 0, 1).astype(np.float32)\n",
        "    cmap = plt.get_cmap(cmap_name)\n",
        "    rgba = cmap(data_norm)\n",
        "    out = (rgba[:, :, :3] * 255).astype(np.uint8)\n",
        "    del data, data_norm, rgba\n",
        "    return out\n",
        "\n",
        "def apply_vis_colormap(data):\n",
        "    data_arr = np.nan_to_num(data, nan=0.0)\n",
        "    if data_arr.max() > data_arr.min():\n",
        "        data_norm = (data_arr - data_arr.min()) / (data_arr.max() - data_arr.min())\n",
        "    else:\n",
        "        data_norm = np.zeros_like(data_arr)\n",
        "    rgb = np.stack([data_norm]*3, axis=-1)\n",
        "    out = (rgb * 255).astype(np.uint8)\n",
        "    del data, data_arr, data_norm, rgb\n",
        "    return out\n",
        "\n",
        "def create_sandwich_composite(b03_data, b13_data):\n",
        "    b03 = b03_data / (np.nanmax(b03_data) + 1e-10)\n",
        "    b13 = (b13_data - np.nanmin(b13_data)) / (np.nanmax(b13_data) - np.nanmin(b13_data) + 1e-10)\n",
        "    b03_smooth = ndimage.gaussian_filter(b03, sigma=3)\n",
        "    b03_edges = np.clip((b03 - b03_smooth) * 8, 0, 1)\n",
        "    blended = np.clip(b13 + b03_edges * 0.4, 0, 1)\n",
        "    cmap = plt.get_cmap(\"inferno\")\n",
        "    rgba = cmap(blended)\n",
        "    out = (rgba[:, :, :3] * 255).astype(np.uint8)\n",
        "    del b03_data, b13_data, b03, b13, b03_smooth, b03_edges, blended, rgba\n",
        "    return out\n",
        "\n",
        "def create_b03_b13_night(b03_data, b13_data, is_night):\n",
        "    if is_night:\n",
        "        out = apply_ir_colormap(b13_data, \"bone\")\n",
        "    else:\n",
        "        out = apply_vis_colormap(b03_data)\n",
        "    return out\n",
        "\n",
        "def create_heavy_rainfall_rgb(b08_data, b13_data, b15_data):\n",
        "    wv = np.nan_to_num(b08_data, nan=200.0)\n",
        "    ir1 = np.nan_to_num(b13_data, nan=300.0)\n",
        "    ir2 = np.nan_to_num(b15_data, nan=300.0)\n",
        "    r = np.clip((wv - 190) / (250 - 190), 0, 1)\n",
        "    g = np.clip(0.5 + (ir1 - ir2) * 2, 0, 1)\n",
        "    b = np.clip((ir1 - 300) / (180 - 300), 0, 1)\n",
        "    rgb = np.stack([r, g, b], axis=-1)\n",
        "    out = (rgb * 255).astype(np.uint8)\n",
        "    del b08_data, b13_data, b15_data, wv, ir1, ir2, r, g, b, rgb\n",
        "    return out\n",
        "\n",
        "def save_rgb_array(rgb_array, filename):\n",
        "    img = Image.fromarray(rgb_array.astype(np.uint8), mode='RGB')\n",
        "    img.save(filename, optimize=True)\n",
        "    del img, rgb_array\n",
        "    gc.collect()\n",
        "    return filename\n",
        "\n",
        "# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n",
        "#  🖼 FRAME PROCESSOR (RAM OPTIMIZED)\n",
        "# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n",
        "\n",
        "def process_frame_parallel(dt, info, master_area_obj, frame_idx, total_frames):\n",
        "    t_str = dt.strftime(\"%Y%m%d_%H%M\")\n",
        "    d_path = dt.strftime(\"%Y/%m/%d/%H%M/\")\n",
        "    active_composite = COMPOSITE_CHOICE\n",
        "    bands_needed = list(COMPOSITE_BANDS[active_composite])\n",
        "\n",
        "    # Add fallback bands to download list if needed\n",
        "    if active_composite in DAY_ONLY_COMPOSITES and USE_NIGHT_FALLBACK:\n",
        "        fb_name = NIGHT_FALLBACK_MAP.get(active_composite, \"B13 (Infrared)\")\n",
        "        for b in COMPOSITE_BANDS[fb_name]:\n",
        "            if b not in bands_needed: bands_needed.append(b)\n",
        "\n",
        "    tasks = []\n",
        "    for b in bands_needed:\n",
        "        res = BAND_RESOLUTION[b]\n",
        "        for s in range(1, info[\"total_segs\"] + 1):\n",
        "            fn = f\"{info['sat_id']}_{t_str}_{b}_{info['area']}_{res}_S{s:02d}{info['total_segs']:02d}.DAT\"\n",
        "            tasks.append((f\"{info['root']}{d_path}{fn}.bz2\", fn))\n",
        "\n",
        "    print(f\"[{frame_idx+1}/{total_frames}] {t_str} DL {len(tasks)} segs...\", end=\"\", flush=True)\n",
        "\n",
        "    # RAM SAFE: Lower worker count prevents 40x120MB decompression spike\n",
        "    with concurrent.futures.ThreadPoolExecutor(max_workers=DOWNLOAD_WORKERS) as pool:\n",
        "        local_files = [r for r in pool.map(lambda p: download_and_extract(*p), tasks) if r]\n",
        "\n",
        "    if not local_files:\n",
        "        print(\" ⚠ Miss\", flush=True)\n",
        "        return None\n",
        "    print(\" ✓\", flush=True)\n",
        "\n",
        "    out_fn = f\"Himawari_{info['area']}_{t_str}.png\" if MODE == \"Single Image\" else f\"frame_{frame_idx:04d}.png\"\n",
        "    scn = None\n",
        "\n",
        "    try:\n",
        "        scn = Scene(filenames=local_files, reader=\"ahi_hsd\")\n",
        "\n",
        "        # ---------------------------------------------------------\n",
        "        # 1. SATPY BUILT-IN COMPOSITES (Memory Safe)\n",
        "        # ---------------------------------------------------------\n",
        "        if active_composite in SATPY_COMPOSITE_NAMES:\n",
        "            satpy_name = SATPY_COMPOSITE_NAMES[active_composite]\n",
        "            scn.load([satpy_name])\n",
        "\n",
        "            # RAM CRITICAL: Delete raw base bands immediately after composite math is done\n",
        "            for b in list(scn.keys()):\n",
        "                if b != satpy_name: del scn[b]\n",
        "            gc.collect()\n",
        "\n",
        "            # Now only the final 3-channel composite is in memory\n",
        "            local_scn = scn.resample(master_area_obj, resampler=\"bilinear\")\n",
        "            local_scn.save_dataset(satpy_name, filename=out_fn, writer=\"simple_image\", enhance=True)\n",
        "            del local_scn, scn; scn = None\n",
        "            gc.collect()\n",
        "            return out_fn\n",
        "\n",
        "        # ---------------------------------------------------------\n",
        "        # 2. NIGHT DETECTION (Ultra low footprint)\n",
        "        # ---------------------------------------------------------\n",
        "        is_night = False\n",
        "        if active_composite in DAY_ONLY_COMPOSITES and USE_NIGHT_FALLBACK:\n",
        "            scn.load([\"B03\"], calibration=\"reflectance\")\n",
        "            local_tmp = scn.resample(master_area_obj, resampler=\"nearest\")\n",
        "            is_night = np.nanmax(local_tmp[\"B03\"].values) < 0.02\n",
        "            del local_tmp\n",
        "            if \"B03\" in scn: del scn[\"B03\"]\n",
        "            gc.collect()\n",
        "\n",
        "            if is_night:\n",
        "                active_composite = NIGHT_FALLBACK_MAP.get(active_composite, \"B13 (Infrared)\")\n",
        "                print(f\"    🌙 Night -> {active_composite}\", flush=True)\n",
        "\n",
        "        # ---------------------------------------------------------\n",
        "        # 3. CUSTOM COMPOSITES (Sequential Band Loading)\n",
        "        # ---------------------------------------------------------\n",
        "        active_bands = COMPOSITE_BANDS[active_composite]\n",
        "        band_arrays = {}\n",
        "\n",
        "        # Load ONE band at a time to prevent holding 3-4 full FLDK arrays simultaneously\n",
        "        for b in active_bands:\n",
        "            cal = \"brightness_temperature\" if b in IR_BANDS else \"reflectance\"\n",
        "            scn.load([b], calibration=cal)\n",
        "            local_scn = scn.resample(master_area_obj, resampler=\"nearest\") # nearest uses 0 buffer RAM\n",
        "            band_arrays[b] = np.array(local_scn[b].values, dtype=np.float32)\n",
        "\n",
        "            del local_scn\n",
        "            if b in scn: del scn[b] # Free raw satellite data immediately\n",
        "            gc.collect()\n",
        "\n",
        "        # Free Satpy entirely before numpy math\n",
        "        del scn; scn = None\n",
        "        gc.collect()\n",
        "\n",
        "        # Render\n",
        "        rgb = None\n",
        "        if active_composite in SINGLE_BANDS:\n",
        "            band_id = active_composite.split(\" \")[0]\n",
        "            if band_id in IR_BANDS:\n",
        "                cmap = \"bone\" if band_id == \"B13\" else \"inferno\"\n",
        "                rgb = apply_ir_colormap(band_arrays[band_id], cmap)\n",
        "            else:\n",
        "                rgb = apply_vis_colormap(band_arrays[band_id])\n",
        "        elif active_composite == \"Sandwich (B03 + B13)\":\n",
        "            rgb = create_sandwich_composite(band_arrays[\"B03\"], band_arrays[\"B13\"])\n",
        "        elif active_composite == \"B03 and B13 at night\":\n",
        "            rgb = create_b03_b13_night(band_arrays[\"B03\"], band_arrays[\"B13\"], is_night)\n",
        "        elif active_composite == \"Heavy Rainfall Potential\":\n",
        "            rgb = create_heavy_rainfall_rgb(band_arrays[\"B08\"], band_arrays[\"B13\"], band_arrays[\"B15\"])\n",
        "\n",
        "        del band_arrays\n",
        "        gc.collect()\n",
        "\n",
        "        if rgb is not None:\n",
        "            return save_rgb_array(rgb, out_fn)\n",
        "\n",
        "    except Exception as e:\n",
        "        print(f\"    ⚠ Err: {e}\", flush=True)\n",
        "    finally:\n",
        "        if scn is not None: del scn\n",
        "        for f in local_files:\n",
        "            if os.path.exists(f): os.remove(f)\n",
        "        gc.collect()\n",
        "    return None\n",
        "\n",
        "# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n",
        "#  🗺 GEOGRAPHY LOCKING (NATIVE RESOLUTION)\n",
        "# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n",
        "\n",
        "info = parse_url(USER_URL)\n",
        "start_dt = datetime.strptime(info[\"timestamp\"], \"%Y%m%d_%H%M\")\n",
        "steps = [start_dt] if MODE == \"Single Image\" else [start_dt - timedelta(minutes=i * INTERVAL_MINUTES) for i in range(int(HOURS_BACK * 60 / INTERVAL_MINUTES))]\n",
        "if MODE != \"Single Image\": steps.reverse()\n",
        "\n",
        "print(\"⚓ Scanning frames for common area (Native Res)...\")\n",
        "all_extents, template_area = [], None\n",
        "\n",
        "for dt in steps:\n",
        "    t_str = dt.strftime(\"%Y%m%d_%H%M\")\n",
        "    d_path = dt.strftime(\"%Y/%m/%d/%H%M/\")\n",
        "    fn = f\"{info['sat_id']}_{t_str}_B13_{info['area']}_R20_S01{info['total_segs']:02d}.DAT\"\n",
